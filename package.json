{
  "name": "energyplanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --test tests/*.test.mjs",
    "test:ai": "node --experimental-strip-types --test tests/prioritize-core.test.mjs",
    "test:checkin": "node --experimental-strip-types --test tests/checkin.test.mjs",
    "test:calendar": "node --experimental-strip-types --test tests/calendar-planning.test.mjs",
    "test:confirm": "node --experimental-strip-types --test tests/confirm.test.mjs",
    "test:diet": "node --experimental-strip-types --test tests/diet.test.mjs",
    "test:diet-ranges": "node --experimental-strip-types --test tests/diet-ranges.test.mjs",
    "test:meal-edit": "node --experimental-strip-types --experimental-test-module-mocks --test tests/meal-edit-behavior.test.mjs",
    "test:energy": "node --experimental-strip-types --test tests/energy-history.test.mjs",
    "test:profile": "node --experimental-strip-types --test tests/profile-settings.test.mjs",
    "test:streak": "node --experimental-strip-types --test tests/streak.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "element-plus": "^2.14.8",
    "pinia": "^4.1.0",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.14"
  }
}
